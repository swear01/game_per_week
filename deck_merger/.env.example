# 複製為 .env 後填入真值；勿提交 .env
# cp .env.example .env

# LiteLLM 模型字串（範例，實際名稱以 https://docs.litellm.ai/docs/providers 為準）
DECK_MERGER_LLM_MODEL=gemini/gemini-2.0-flash

# 各後端 API key（依你選的模型擇一或多個設定；名稱見 LiteLLM Providers 文件）
# GEMINI_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here
# OPENROUTER_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# 可選
# DECK_MERGER_SEED=0
# 覆寫 knowhow 子目錄（預設等於套件 __version__）
# DECK_MERGER_KNOWHOW_VERSION=0.1.0
# 注入 prompt 的 knowhow 總字元上限
# DECK_MERGER_KNOWHOW_MAX_CHARS=12000
# 局終寫入 session_notes（預設開啟）；設為 0 / false / no / off 關閉，或腳本加 --no-learn
# DECK_MERGER_LEARN=0
